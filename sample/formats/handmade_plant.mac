NEW EQUIPMENT /PUMP-01
  AT E 1000 N 2000 U 0
  NEW CYLINDER /BODY
    DIAMETER 800
    HEIGHT 1500
    AT E 0 N 0 U 750
  END
  NEW BOX /BASE
    XLENGTH 1400
    YLENGTH 1000
    ZLENGTH 200
    AT E 0 N 0 U -100
  END
  NEW CONE /TOP
    DTOP 200
    DBOTTOM 800
    HEIGHT 400
    AT E 0 N 0 U 1700
  END
  NEW CTORUS /ELBOW
    RINSIDE 300
    ROUTSIDE 500
    ANGLE 90
    AT E 900 N 0 U 1200
    ORIENTED X IS E AND Y IS U
  END
  NEW CYLINDER /PIPE
    DIAMETER 200
    HEIGHT 3000
    AT E 2400 N 0 U 1200
    ORIENTED X IS N AND Y IS U
  END
END
NEW EQUIPMENT /TANK-01
  AT E 6000 N 2000 U 0
  NEW CYLINDER /SHELL
    DIAMETER 2400
    HEIGHT 3000
    AT E 0 N 0 U 1500
  END
  NEW DISH /ROOF
    DIAMETER 2400
    HEIGHT 500
    AT E 0 N 0 U 3000
  END
  NEW SNOUT /NOZZLE
    DTOP 150
    DBOTTOM 300
    HEIGHT 400
    XOFF 0
    YOFF 50
    AT E 1400 N 0 U 2500
    ORIENTED X IS N AND Y IS U
  END
END
